{
  "_comment": "Starting point for a new renter org. Replace orgName / orgId / orgSlug and the database with the values of the new org. Pass the connection string with MONGO_URI, --uri or .env, never in this file.",
  "org": {
    "orgName": "acme-labs.example.com",
    "orgSlug": "<ORG-SLUG>",
    "orgId": "<ORG-ID-OF-THE-NEW-ORG>",
    "region": "us-east-1"
  },
  "mongo": { "database": "<DATABASE-OF-THE-NEW-ORG>" },
